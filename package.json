{
  "name": "docs-theme-extras",
  "version": "0.1.0",
  "private": true,
  "description": "Solo overlay on top of the Hextra Hugo theme. Ships shortcodes, partials, and a bundled HTML test harness runnable against any Hugo doc set via `make test CONFIG=path/to/x.toml`.",
  "scripts": {
    "test": "playwright test",
    "test:static": "playwright test --project=static",
    "test:content": "playwright test --project=content",
    "test:browser": "playwright test --project=browser",
    "test:browser-crawl": "playwright test --project=browser-crawl",
    "report": "playwright show-report",
    "scan:overrides": "node scripts/scan-overrides.mjs",
    "scan:gates": "node scripts/scan-gates.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "parse5": "^8.0.1",
    "serve": "^14.2.4",
    "smol-toml": "^1.8.0"
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
